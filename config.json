    { "arch": "python-matplotlib",      "fedora": "python3-matplotlib",                 "ubuntu": "python3-matplotlib" },
    { "arch": "python-scikit-learn",    "fedora": "python3-scikit-learn",               "ubuntu": "python3-scikit-learn" },
    { "arch": "python-requests",        "fedora": "python3-requests",                   "ubuntu": "python3-requests" },
    { "arch": "python-beautifulsoup4",  "fedora": "python3-beautifulsoup4",             "ubuntu": "python3-bs4" },
    { "arch": "pipewire-jack",          "fedora": "pipewire-jack-audio-connection-kit", "ubuntu": "pipewire-jack" },
    { "arch": ["noto-fonts", "noto-fonts-cjk"], "fedora": ["google-noto-fonts-common", "google-noto-cjk-fonts"], "ubuntu": ["fonts-noto", "fonts-noto-cjk"] },
    { "arch": "gnome-tweaks",           "fedora": "gnome-tweaks",                       "ubuntu": "gnome-tweaks" },
