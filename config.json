    { "arch": "flatpak",                "fedora": "flatpak",                            "ubuntu": "flatpak" },
    { "arch": "gnome-shell",            "fedora": "gnome-shell",                        "ubuntu": "gnome-shell" },
    { "arch": "papers",                 "fedora": "gnome-papers" },
    { "arch": "firefox",                "fedora": "firefox",                            "ubuntu": "firefox" },
    { "arch": "ptyxis" },
    { "arch": "baobab",                 "fedora": "baobab",                             "ubuntu": "baobab" },
    { "arch": "python",                 "fedora": "python3",                            "ubuntu": "python3" },
