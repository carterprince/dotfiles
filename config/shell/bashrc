# non-interactive shells get nothing from here
[[ $- != *i* ]] && return

# system defaults: bash-completion, vte, PackageKit command-not-found
[ -f /etc/bashrc ] && . /etc/bashrc

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias poweroff='sudo systemctl poweroff -i'
alias vim='nvim'
alias tree='tree -aC -I .git -I .venv'

PS1="\[\e[1;31m\]\w\[\e[0m\] \$ "

set -o vi
shopt -s globstar

# history: large, no duplicates, and shared between open terminals right away
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
