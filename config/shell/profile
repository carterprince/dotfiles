# env stuff
export DEVKITPRO=/opt/devkitpro
export DEVKITARM=/opt/devkitpro/devkitARM
export ANDROID_HOME=$HOME/.android/sdk
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.npm-global/bin:$HOME/.local/share/gem/ruby/3.4.0/bin:$DEVKITPRO/tools/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:/usr/local/cuda/bin:$PATH"
export LD_LIBRARY_PATH="/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export EDITOR="nvim"
export MANPAGER="less -R --use-color -DP+yk -Dd+y -Du+y"
export MANROFFOPT="-c"
export PKGFILE_PROMPT_INSTALL_MISSING=1
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export PYTHONUNBUFFERED=1

[ -f "$HOME/.secrets" ] && source $HOME/.secrets

# Bigger console font on 4K monitor (only on the Linux console, not a terminal emulator)
if [ "$TERM" = linux ] && [ -x /usr/bin/setfont ]; then
    setfont latarcyrheb-sun32
fi
