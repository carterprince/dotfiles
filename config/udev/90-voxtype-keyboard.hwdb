# Right Shift becomes F14 for voxtype; Caps Lock becomes an additional Escape.
# USB and Bluetooth HID keyboards use usage page 0x07.
evdev:input:b0003*
evdev:input:b0005*
 KEYBOARD_KEY_700e5=f14
 KEYBOARD_KEY_700e6=rightalt
 KEYBOARD_KEY_70039=esc

# ThinkPad AT keyboard: 0x36 is Right Shift, 0xb8 is Right Alt, 0x3a is Caps Lock.
evdev:atkbd:dmi:*:svnLENOVO*:pn*:pvrThinkPad*:*
 KEYBOARD_KEY_36=f14
 KEYBOARD_KEY_b8=rightalt
 KEYBOARD_KEY_3a=esc
